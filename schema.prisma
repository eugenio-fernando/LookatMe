datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider  = "prisma-client-py"
  interface = "sync"
}

model Workspace {
  id         Int    @id @default(autoincrement())
  name       String
  created_at String
}

model WorkspaceMember {
  id           Int    @id @default(autoincrement())
  workspace_id Int
  user_id      Int
  role         String @default("member")
}

model Todo {
  id           Int     @id @default(autoincrement())
  workspace_id Int     @default(0)
  created_by   Int     @default(0)
  user_id      Int     @default(0)
  timestamp    String
  text         String
  priority     String  @default("medium")
  due_date     String  @default("")
  completed    Boolean @default(false)
}

model Streak {
  id                  Int    @id
  current_streak      Int    @default(0)
  last_completed_date String @default("")
  longest_streak      Int    @default(0)
}

model LearningItem {
  id           Int    @id @default(autoincrement())
  title        String
  category     String @default("general")
  progress     Int    @default(0)
  hours_studied Float  @default(0)
  notes        String @default("")
  created_at   String
}

model Message {
  id           Int    @id @default(autoincrement())
  sender_id    Int
  recipient_id Int
  subject      String
  content      String
  created_at   String
  read         Boolean @default(false)
}

model Activity {
  id         Int    @id @default(autoincrement())
  user_id    Int
  type       String
  content    String
  created_at String
}

model ActivityEvent {
  id            Int    @id @default(autoincrement())
  user_id       Int
  event_type    String
  description   String
  message       String   @default("")
  visibility    String   @default("space")
  space_id      Int?
  created_at    DateTime @default(now())
  metadata_json String @default("")

  @@index([visibility])
  @@index([space_id])
}

model Space {
  id          Int      @id @default(autoincrement())
  name        String
  owner_id    Int
  invite_code String   @unique
  created_at  DateTime @default(now())

  @@index([owner_id])
}

model SpaceMember {
  id        Int      @id @default(autoincrement())
  space_id  Int
  user_id   Int
  role      String   @default("member")
  joined_at DateTime @default(now())

  @@index([space_id])
  @@index([user_id])
  @@unique([space_id, user_id])
}

model ActivityReaction {
  id            Int      @id @default(autoincrement())
  event_id      Int
  user_id       Int
  reaction_type String
  created_at    DateTime @default(now())

  @@index([event_id])
}

model Invitation {
  id                Int     @id @default(autoincrement())
  sender_id         Int
  token             String  @unique
  method            String  @default("copy")
  created_at        String
  opened_at         String?
  accepted_at       String?
  recipient_user_id Int?
  invitee_email     String?
}

model FriendInvite {
  id          Int      @id @default(autoincrement())
  inviter_id  Int
  email       String
  token       String   @unique
  status      String   @default("pending")
  created_at  DateTime @default(now())
  accepted_at DateTime?

  @@index([inviter_id])
  @@index([email])
}

model Friendship {
  id          Int     @id @default(autoincrement())
  user_a      Int
  user_b      Int
  created_at  String
  accepted_at String?
}

model WorkspaceInvite {
  id           Int     @id @default(autoincrement())
  workspace_id Int
  email        String
  token        String  @unique
  created_at   String
  expires_at   String
  accepted     Boolean @default(false)
}

model User {
  id            Int    @id @default(autoincrement())
  email         String @unique
  password_hash String
  created_at    String
  display_name  String @default("")
  nickname      String @default("")
  avatar_url    String @default("")
  avatar_path   String @default("")
  language      String @default("en")
  bio           String @default("")
  company       String @default("")
  address       String @default("")
  city          String @default("")
  zip_code      String @default("")
  phone         String @default("")
  hobbies       String @default("")
  interests     String @default("")
  gender        String @default("prefer_not_to_say")
  instagram_username String @default("")
  favorite_topics     String @default("")
  favorite_news_sources String @default("")
  favorite_teams      String @default("")

  // Email verification
  verified              Boolean @default(false)
  verification_token    String?
  verification_expiry   String?

  // Magic login
  magic_login_token     String?
  magic_login_expiry    String?

  // Password reset via email
  reset_token           String?
  reset_expiry          String?

  // LinkedIn
  linkedin_url               String?
  linkedin_verified          Boolean @default(false)
  linkedin_verification_code String?
  linkedin_verify_attempts   Int     @default(0)

  // Daily Commitment
  daily_commitment           String?
  daily_commitment_date      String?
  daily_commitment_completed Boolean @default(false)

  // Onboarding
  has_seen_onboarding   Boolean @default(false)
  last_onboarding_seen  String  @default("")

  // Per-user streak (maintained alongside global Streak record)
  current_streak        Int    @default(0)
  longest_streak        Int    @default(0)
  last_completed_date   String @default("")

  // Session tracking
  last_login_at         String @default("")
  welcome_day_key       String @default("")
  welcome_count_today   Int    @default(0)
  focus_sessions_today  Int    @default(0)
  focus_sessions_total  Int    @default(0)
  focus_streak          Int    @default(0)
  longest_focus_streak  Int    @default(0)
  focus_day_key         String @default("")
}

model Challenge {
  id         Int      @id @default(autoincrement())
  space_id   Int
  title      String
  goal       Int
  metric     String
  created_by Int
  created_at DateTime @default(now())

  @@index([space_id])
}

model ChallengeProgress {
  id           Int @id @default(autoincrement())
  challenge_id Int
  user_id      Int
  progress     Int @default(0)

  @@index([challenge_id])
  @@index([user_id])
  @@unique([challenge_id, user_id])
}

model FocusSession {
  id           Int    @id @default(autoincrement())
  user_id      Int
  start_time   DateTime?
  duration     Int?
  task         String @default("")
  status       String @default("active")
  phase        String @default("focus")
  started_at   String
  ends_at      String
  completed_at String?
  duration_sec Int    @default(1500)
}

model VipContact {
  id          Int    @id @default(autoincrement())
  user_id     Int
  vip_user_id Int
  created_at  String

  @@unique([user_id, vip_user_id])
}

model DailyMission {
  id           Int     @id @default(autoincrement())
  user_id      Int
  date         String
  tasks_goal   Int     @default(3)
  habits_goal  Int     @default(1)
  notes_goal   Int     @default(1)
  completed    Boolean @default(false)
}

model AIUsage {
  id           Int    @id @default(autoincrement())
  user_id      Int
  date         String
  request_type String
  created_at   String
}

model AIResponseCache {
  id         Int    @id @default(autoincrement())
  user_id    Int
  type       String
  date       String
  response   String
  created_at String
}

model VerificationEmailAttempt {
  id         Int    @id @default(autoincrement())
  user_id    Int
  email      String
  created_at String
}

model EmailWebhookEvent {
  id         Int    @id @default(autoincrement())
  provider   String
  event_type String
  email      String?
  message_id String?
  payload    String
  created_at String
}
